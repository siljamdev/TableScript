//Importing the standard library for print and stdnum to print human-readable numbers
import stdlib;
import stdnum;

//This program prints the 10 first numbers of the fibonacci sequence

foreach num @ stdnum::range("0", "10", "1"){
	print(num + ": " + fibonacci(num.toLen()).toNum());
}

function fibonacci(n){
    if n <= 1{
        return n;
    }
	
	//Recursion
    return fibonacci(n - 1) + fibonacci(n - 2);
}