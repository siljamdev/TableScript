<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	
	<PackageId>TableScript</PackageId>
    <Version>1.5.7</Version>
	<PackageVersion>1.5.7</PackageVersion>
    <Authors>siljam</Authors>
    <Company>AshProject</Company>
	
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    
    <PackageDescription>String table based scripting languange</PackageDescription>
	
	<RepositoryUrl>https://github.com/siljamdev/TableScript</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageProjectUrl>https://github.com/siljamdev/TableScript</PackageProjectUrl>
	
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageIcon>res/icon.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<!--@propertyGr-->
  </PropertyGroup>
  
  <ItemGroup>
	<Compile Remove="examples/**" />
	<Compile Remove="exec/**" />
	<Compile Remove="tests/**" />
	<Compile Remove="TableScript.Generator/**" />
	
	<ProjectReference Include="TableScript.Generator/TableScript.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	<None Include="TableScript.Generator/bin/$(Configuration)/net6.0/TableScript.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	
	<None Include="res/icon.png" Pack="true" PackagePath="res/" />
	<None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>